{% set visibleForums = forums|filter(forum => can('view', forum)) %}
{% if visibleForums is not empty %}
    <div class="cdc-forum-group mb-8">
        {% if title is defined %}
            <div class="cdc-forum-group__header flex items-center justify-between pb-3 mb-4 border-b border-[#182238]">
                <h3 class="text-xl font-bold tracking-wider uppercase text-white font-display flex items-center gap-2 m-0">
                    <span class="w-1.5 h-4 bg-[#2b4bb0] rounded-sm inline-block"></span>
                    {{ title }}
                </h3>
            </div>
        {% endif %}

        <div class="cdc-forum-grid">
            {% for forum in visibleForums %}
                {% set link = path('forumify_forum_forum', { slug: forum.slug }) %}
                {% set isFullWidth = (loop.last and (visibleForums|length % 2 != 0)) %}
                
                {# Banner image resolution #}
                {% set bannerUrl = forum.banner 
                    ? asset(forum.banner, 'forumify.asset') 
                    : asset('storage/assets/nodes/node_' ~ forum.id ~ '.jpg') %}

                <div class="cdc-forum-card {% if isFullWidth %}cdc-forum-card--full{% endif %}" 
                     style="--forum-bg-img: url('{{ bannerUrl }}');">
                    
                    <div class="cdc-forum-card__bg"></div>
                    <div class="cdc-forum-card__overlay"></div>

                    <div class="cdc-forum-card__body">
                        {# Top section: Icon + Title + Description + Stats #}
                        <div class="cdc-forum-card__main">
                            <div class="cdc-forum-card__icon">
                                <i class="ph ph-chat-text"></i>
                            </div>
                            <div class="cdc-forum-card__info">
                                <div class="flex items-center gap-2">
                                    <h4 class="cdc-forum-card__title">
                                        <a href="{{ link }}">{{ forum.title }}</a>
                                    </h4>
                                    {{ component('ReadMarker', { item: forum }) }}
                                </div>
                                
                                {% if forum.content %}
                                    <p class="cdc-forum-card__desc">{{ forum.content|striptags|u.truncate(140, '...') }}</p>
                                {% endif %}

                                <div class="cdc-forum-card__stats">
                                    <span class="cdc-stat-item">
                                        <i class="ph ph-chat-circle-dots"></i>
                                        {{ forum.topics|length }} fils
                                    </span>

                                    {% if forum.children is not empty %}
                                        <div class="cdc-subforums-wrapper" data-controller="dropdown">
                                            <button type="button" class="cdc-subforums-btn" data-action="dropdown#toggle">
                                                <i class="ph ph-git-fork"></i>
                                                Sub-fòrums ({{ forum.children|length }})
                                                <i class="ph ph-caret-down text-xs"></i>
                                            </button>
                                            <div class="cdc-subforums-dropdown d-none" data-dropdown-target="menu">
                                                {% for subforum in forum.children|filter(subforum => can('view', subforum)) %}
                                                    <a href="{{ path('forumify_forum_forum', { slug: subforum.slug }) }}" class="cdc-subforum-item">
                                                        <i class="ph ph-arrow-bend-down-right"></i>
                                                        <span>{{ subforum.title }}</span>
                                                    </a>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        {# Bottom section: Latest post & Navigation arrow #}
                        {% set lastComment = forum|last_comment %}
                        <div class="cdc-forum-card__footer">
                            {% if lastComment is not null %}
                                {% set topic = lastComment.topic %}
                                <div class="cdc-forum-card__latest">
                                    <a href="{{ path('forumify_forum_topic', { slug: topic.slug }) }}" class="cdc-latest-topic-link" title="{{ topic.title }}">
                                        {{ topic.title|u.truncate(45, '...') }}
                                    </a>
                                    <div class="cdc-latest-meta">
                                        <span>{{ lastComment.createdAt|format_date }}</span>
                                        <span class="opacity-40">·</span>
                                        <span class="cdc-latest-author">
                                            {% include '@Forumify/components/username.html.twig' with { user: lastComment.createdBy } only %}
                                        </span>
                                    </div>
                                </div>
                            {% else %}
                                <div class="cdc-forum-card__latest opacity-50">
                                    <span class="text-xs text-[#8a93a3]">Sense activitat recent</span>
                                </div>
                            {% endif %}

                            <a href="{{ link }}" class="cdc-forum-card__arrow" aria-label="Entrar a {{ forum.title }}">
                                <i class="ph ph-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}

<style>
/* Tactical 2-Column Forum Tile Grid Layout */
.cdc-forum-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
}

@media (max-width: 900px) {
    .cdc-forum-grid {
        grid-template-columns: 1fr;
    }
}

.cdc-forum-card {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background-color: #0b111c;
    border: 1px solid #182238;
    min-height: 180px;
    display: flex;
    flex-direction: column;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
}

.cdc-forum-card--full {
    grid-column: 1 / -1;
}

.cdc-forum-card:hover {
    border-color: #2b4bb0;
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(43, 75, 176, 0.25), 0 0 15px rgba(43, 75, 176, 0.15);
}

.cdc-forum-card__bg {
    position: absolute;
    inset: 0;
    background-image: var(--forum-bg-img);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.45;
    transition: opacity 0.3s ease, transform 0.4s ease;
    z-index: 1;
}

.cdc-forum-card:hover .cdc-forum-card__bg {
    opacity: 0.65;
    transform: scale(1.03);
}

.cdc-forum-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(5, 8, 15, 0.92) 0%, rgba(10, 17, 28, 0.82) 55%, rgba(5, 8, 15, 0.95) 100%);
    z-index: 2;
}

.cdc-forum-card__body {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: 18px 20px;
    gap: 16px;
}

.cdc-forum-card__main {
    display: flex;
    align-items: flex-start;
    gap: 14px;
}

.cdc-forum-card__icon {
    width: 38px;
    height: 38px;
    min-width: 38px;
    border-radius: 6px;
    background: rgba(30, 58, 138, 0.25);
    border: 1px solid rgba(43, 75, 176, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #60a5fa;
    font-size: 1.25rem;
}

.cdc-forum-card__info {
    flex: 1;
    min-width: 0;
}

.cdc-forum-card__title {
    margin: 0;
    font-family: 'Oswald', 'Barlow Condensed', sans-serif !important;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.3;
}

.cdc-forum-card__title a {
    color: #ffffff !important;
    text-decoration: none;
    transition: color 0.15s ease;
}

.cdc-forum-card__title a:hover {
    color: #60a5fa !important;
    text-shadow: 0 0 10px rgba(96, 165, 250, 0.5);
}

.cdc-forum-card__desc {
    margin: 4px 0 8px 0;
    font-size: 0.85rem;
    color: #a8b0bf;
    line-height: 1.45;
}

.cdc-forum-card__stats {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.78rem;
    color: #8a93a3;
}

.cdc-stat-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(15, 23, 42, 0.6);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.06);
}

.cdc-subforums-wrapper {
    position: relative;
}

.cdc-subforums-btn {
    background: rgba(30, 58, 138, 0.2);
    border: 1px solid rgba(43, 75, 176, 0.3);
    color: #93c5fd;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.78rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all 0.15s ease;
}

.cdc-subforums-btn:hover {
    background: rgba(43, 75, 176, 0.4);
    color: #ffffff;
}

.cdc-subforums-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    background: #0b111c;
    border: 1px solid #182238;
    border-radius: 6px;
    padding: 6px;
    min-width: 180px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.7);
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.cdc-subforum-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    color: #e2e8f0 !important;
    font-size: 0.8rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.15s ease;
}

.cdc-subforum-item:hover {
    background: #1e3a8a;
    color: #ffffff !important;
}

.cdc-forum-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 10px;
    margin-top: auto;
}

.cdc-forum-card__latest {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
    padding-right: 12px;
}

.cdc-latest-topic-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: #e2e8f0 !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;
    transition: color 0.15s ease;
}

.cdc-latest-topic-link:hover {
    color: #60a5fa !important;
}

.cdc-latest-meta {
    font-size: 0.72rem;
    color: #8a93a3;
    display: flex;
    align-items: center;
    gap: 6px;
}

.cdc-latest-author span, .cdc-latest-author a {
    color: #93c5fd !important;
    font-weight: 500;
}

.cdc-forum-card__arrow {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.cdc-forum-card:hover .cdc-forum-card__arrow {
    background: #2b4bb0;
    border-color: #3b82f6;
    color: #ffffff;
    transform: translateX(3px);
    box-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
}
</style>
