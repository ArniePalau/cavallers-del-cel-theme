            <div class="cdc__container cdc__nav-inner" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                {% block header_logo %}
                    <a href="{{ path('forumify_core_index') }}" class="cdc__brand" aria-label="{{ setting('forumify.title') }}">
