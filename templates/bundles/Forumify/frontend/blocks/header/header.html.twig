                        {{ setting('forumify.title') }}
                    </a>
                {% endblock %}

                {% block header_navigtion %}
                    <div style="display: flex; flex-grow: 1; justify-content: flex-end; align-items: center;">
                        {% include '@Forumify/frontend/blocks/header/menu_large.html.twig' %}
                        {% include '@Forumify/frontend/blocks/header/menu_mobile.html.twig' %}
                        {% if app.user is not null %}
                            {{ component('Notifications') }}
                        {% endif %}

                    </div>
                {% endblock %}
            </div>
        </nav>
    </div>

    <script>
    document.addEventListener("DOMContentLoaded", function() {
        const nav = document.getElementById("cdc-navbar");
        if (nav && document.querySelector('.cdc__hero')) {
            const onScroll = () => {
                if (window.scrollY > 40) {
                    nav.classList.add("cdc__nav--scrolled");
                } else {
                    nav.classList.remove("cdc__nav--scrolled");
                }
            };
            onScroll();
            window.addEventListener("scroll", onScroll, { passive: true });
        }
    });
    </script>
