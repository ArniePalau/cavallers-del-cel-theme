        <!-- Groups -->
        <section id="grups" class="cdc__section cdc__reveal">
            <div class="cdc__container">
                <div class="cdc__section-head cdc__section-head--center">
                    <span class="cdc__eyebrow">Els nostres grups</span>
                    <h2 class="cdc__h2">Quatre fronts.<br>Una Comunitat.</h2>
                    <p class="cdc__lead cdc__groups-lead">Cavallers del Cel agrupa quatre divisions especialitzades. Cada soldat tria el seu terreny, i tots comparteixen la mateixa disciplina.</p>
                </div>
                <div class="cdc__groups-grid">
                    <!-- Group cards -->
                    <article class="cdc__group-card">
                        <img src="/themes/cavallers-del-cel/theme/images/senglars.png" alt="Senglars" class="cdc__group-emblem cdc__group-emblem--img" loading="lazy">
                        <h3 class="cdc__group-title">DCS World</h3>
                        <p class="cdc__group-body">Combat aeri modern amb F-18C, A-10C, Ka-50, Mirage 2000 i UH-1H Huey. Novells i veterans, tots benvinguts.</p>
                        <a href="#" class="cdc__btn cdc__btn--ghost cdc__group-cta">Divisió DCS</a>
                    </article>
                    <article class="cdc__group-card cdc__group-card--video">
                        <div class="cdc__group-video-wrap">
                            <video class="cdc__group-video" src="/themes/cavallers-del-cel/theme/videos/arma3-bg.mp4" loop muted playsinline preload="auto"></video>
                            <div class="cdc__group-video-overlay"></div>
                        </div>
                        <img src="/themes/cavallers-del-cel/theme/images/arma_amfibi.png" alt="1er Reconeixement Amfibi" class="cdc__group-emblem cdc__group-emblem--img" loading="lazy">
                        <h3 class="cdc__group-title">Arma 3</h3>
                        <p class="cdc__group-body">Reconeixement, infiltració, sabotatge i suport aeri amb els marines catalans del 1er Reconeixement Amfibi.</p>
                        <a href="#" class="cdc__btn cdc__btn--ghost cdc__group-cta">Divisió Arma 3</a>
                    </article>
                    <script>
                    document.addEventListener("DOMContentLoaded", function() {
                        document.querySelectorAll('.cdc__group-card--video').forEach(function(card) {
                            var video = card.querySelector('.cdc__group-video');
                            if (!video) return;

                            card.addEventListener('mouseenter', function() {
                                video.play().catch(function() {});
                            });

                            card.addEventListener('mouseleave', function() {
                                video.pause();
                                video.currentTime = 0;
                            });
                        });
                    });
                    </script>
                    <article class="cdc__group-card cdc__group-card--video">
                        <div class="cdc__group-video-wrap">
                            <video class="cdc__group-video" src="/themes/cavallers-del-cel/theme/videos/starcitizen-bg.mp4" loop muted playsinline preload="auto"></video>
                            <div class="cdc__group-video-overlay"></div>
                        </div>
                        <img src="/themes/cavallers-del-cel/theme/images/corbs_blaus.png" alt="Corbs Blaus" class="cdc__group-emblem cdc__group-emblem--img" loading="lazy">
                        <h3 class="cdc__group-title">Star Citizen</h3>
                        <p class="cdc__group-body">Els Corbs Blaus: organització de seguretat professional que opera sota contracte a l'espai profund.</p>
                        <a href="#" class="cdc__btn cdc__btn--ghost cdc__group-cta">Divisió Star Citizen</a>
                    </article>
                    <article class="cdc__group-card">
                        <img src="/themes/cavallers-del-cel/theme/images/il2_llops.png" alt="IL-2 Sturmovik" class="cdc__group-emblem cdc__group-emblem--img" loading="lazy">
                        <h3 class="cdc__group-title">IL-2 Sturmovik</h3>
                        <p class="cdc__group-body">Simulació de combat de la Segona Guerra Mundial amb BF-109, P-51 Mustang i campanyes dinàmiques.</p>
                        <a href="#" class="cdc__btn cdc__btn--ghost cdc__group-cta">Divisió IL-2</a>
                    </article>
                </div>
            </div>
        </section>

        <!-- Operations -->
        <section id="operacions" class="cdc__section cdc__reveal">
            <div class="cdc__container">
                <div class="cdc__section-head">
                    <span class="cdc__eyebrow">Operacions destacades</span>
                    <h2 class="cdc__h2">Missions en curs</h2>
                </div>
                <div class="cdc__ops-grid">
                    <article class="cdc__op-card">
                        <div class="cdc__ph cdc__op-image" data-swap="Formació de F-16 sobrevolant els Pirineus" aria-hidden="true"></div>
                        <div class="cdc__op-body">
                            <span class="cdc__op-code">OP-01 · DCS</span>
                            <h3 class="cdc__op-title">Escut del Pirineu</h3>
                            <p class="cdc__op-brief">Patrulla aèria de defensa sobre territori muntanyós.</p>
                            <span class="cdc__op-cta">Llegir informe</span>
                        </div>
                    </article>
                    <article class="cdc__op-card">
                        <div class="cdc__ph cdc__op-image" data-swap="F-16 en aproximació a base desèrtica al capvespre" aria-hidden="true"></div>
                        <div class="cdc__op-body">
                            <span class="cdc__op-code">OP-02 · BMS</span>
                            <h3 class="cdc__op-title">Tempesta de sorra</h3>
                            <p class="cdc__op-brief">Operació d'atac coordinat en escenari desèrtic.</p>
                            <span class="cdc__op-cta">Llegir informe</span>
                        </div>
                    </article>
                    <article class="cdc__op-card">
                        <div class="cdc__ph cdc__op-image" data-swap="Caça sobre el mar al matí, formació de dos" aria-hidden="true"></div>
                        <div class="cdc__op-body">
                            <span class="cdc__op-code">OP-03 · DCS</span>
                            <h3 class="cdc__op-title">Vigilància marítima</h3>
                            <p class="cdc__op-brief">Reconeixement i interceptació sobre el Mediterrani.</p>
                            <span class="cdc__op-cta">Llegir informe</span>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <!-- Community -->
        <section id="comunitat" class="cdc__section cdc__reveal">
            <div class="cdc__container">
                <div class="cdc__section-head">
                    <span class="cdc__eyebrow">Activitat de la comunitat</span>
                    <h2 class="cdc__h2">Vola amb l'esquadró</h2>
                </div>
                <div class="cdc__community-grid">
                    <!-- Calendar -->
                    {% set today = 'now'|date('U') %}
                    {% set monthName = today|date('F') %}
                    {% set year = today|date('Y') %}
                    {% set daysInMonth = today|date('t') %}
                    {% set firstDayOfMonth = today|date('Y-m-01')|date('w') %}
                    {% set firstDayIndex = firstDayOfMonth == 0 ? 7 : firstDayOfMonth %}
                    {% set events = events is defined and events is iterable ? events : [] %}
                    
                    <div class="cdc__panel cdc__panel--calendar">
                        <div class="cdc__panel-head">
                            <h3 class="cdc__panel-title">Calendari d'operacions</h3>
                            <span class="cdc__panel-meta">{{ monthName }} {{ year }}</span>
                        </div>
                        <div class="cdc__cal-weekdays" aria-hidden="true">
                            <span>DL</span><span>DM</span><span>DC</span><span>DJ</span><span>DV</span><span>DS</span><span>DG</span>
                        </div>
                        <div class="cdc__cal-grid" role="list" aria-label="Calendari d'operacions — {{ monthName }} {{ year }}">
                            {% if firstDayIndex > 1 %}
                                {% for i in 1..(firstDayIndex - 1) %}
                                    <div class="cdc__cal-cell" role="presentation"></div>
                                {% endfor %}
                            {% endif %}
                            
                            {% for i in 1..daysInMonth %}
                                <div class="cdc__cal-cell {% if i == today|date('j') %}cdc__cal-cell--today{% endif %}" role="listitem">
                                    <span class="cdc__cal-day">{{ i }}</span>
                                    {% set currentDateStr = today|date('Y-m-') ~ (i < 10 ? '0' ~ i : i) %}
                                    {% set currentDayOfWeek = currentDateStr|date('w') %}
                                    
                                    {% if currentDayOfWeek == 2 %}
                                        <span class="cdc__cal-tag cdc__cal-tag--il2" title="IL2">IL2</span>
                                    {% elseif currentDayOfWeek == 3 or currentDayOfWeek == 6 %}
                                        <span class="cdc__cal-tag cdc__cal-tag--arma3" title="Arma 3">Arma 3</span>
                                    {% elseif currentDayOfWeek == 5 %}
                                        <span class="cdc__cal-tag cdc__cal-tag--dcs" title="DCS">DCS</span>
                                    {% elseif currentDayOfWeek == 0 %}
                                        <span class="cdc__cal-tag cdc__cal-tag--starcitizen" title="Star Citizen">Star Citizen</span>
                                    {% endif %}
                                </div>
                            {% endfor %}
                            
                            {% set totalCells = (firstDayIndex - 1) + daysInMonth %}
                            {% set remainder = totalCells % 7 %}
                            {% set emptyEndCells = remainder == 0 ? 0 : 7 - remainder %}
                            
                            {% if emptyEndCells > 0 %}
                                {% for i in 1..emptyEndCells %}
                                    <div class="cdc__cal-cell" role="presentation"></div>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>

                    <!-- Discord -->
                    <div class="cdc__panel cdc__panel--discord">
                        <div class="cdc__panel-head">
                            <h3 class="cdc__panel-title">Canal Discord</h3>
                            <span class="cdc__panel-meta">En viu</span>
                        </div>
                        <div class="cdc__embed cdc__embed--discord">
                            <iframe title="Discord — Cavallers del Cel" src="https://discord.com/widget?id=152173369813368832&theme=dark" allowtransparency="true" loading="lazy" frameborder="0" sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"></iframe>
                        </div>
                        <a class="cdc__btn cdc__btn--primary cdc__panel-cta" href="https://discord.gg/4RGJdTv" target="_blank" rel="noopener noreferrer">Uneix-te a Discord</a>
                    </div>

                    <!-- Facebook -->
                    <div class="cdc__panel cdc__panel--facebook">
                        <div class="cdc__panel-head">
                            <h3 class="cdc__panel-title">Murs de Facebook</h3>
                            <span class="cdc__panel-meta">Social</span>
                        </div>
                        <div class="cdc__embed cdc__embed--facebook" style="background:#fff; border-radius: var(--cdc-radius-md);">
                            <iframe src="https://www.facebook.com/plugins/page.php?href=https%3A%2F%2Fwww.facebook.com%2Fcavallersdelcel&tabs=timeline&width=340&height=500&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true" width="100%" height="500" style="border:none;overflow:hidden" scrolling="no" frameborder="0" allowfullscreen="true" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Videos -->
        <section id="videos" class="cdc__section cdc__reveal">
            <div class="cdc__container">
                <div class="cdc__section-head">
                    <span class="cdc__eyebrow">Últims vídeos oficials</span>
                    <h2 class="cdc__h2">Del cel a la pantalla</h2>
                </div>
                <div class="cdc__videos-grid">
                    {% set fallbackVideos = [
                        { 'title': 'Op. Headhunter - Tobruk - SAS/LRDG - Op. Stirling - WW2 - 1941- Arma 3', 'url': 'https://www.youtube.com/watch?v=WubgXuCvYRc', 'thumbnail': 'https://i.ytimg.com/vi/WubgXuCvYRc/hqdefault.jpg', 'published': '09/08/2026' },
                        { 'title': 'Op. Dry Run - Tobruk - SAS/LRDG - Op. Stirling - WW2 - 1941- Arma 3', 'url': 'https://www.youtube.com/watch?v=8HgZ6qNRZv0', 'thumbnail': 'https://i.ytimg.com/vi/8HgZ6qNRZv0/hqdefault.jpg', 'published': '01/08/2026' },
                        { 'title': 'A pel morter - Kunduz River - Hearts and Minds - Arma 3', 'url': 'https://www.youtube.com/watch?v=qDQlLsZr7w8', 'thumbnail': 'https://i.ytimg.com/vi/qDQlLsZr7w8/hqdefault.jpg', 'published': '23/07/2026' },
                        { 'title': 'Op. First Blood - Tobruk - SAS/LRDG - Op. Stirling - WW2 - 1941- Arma 3', 'url': 'https://www.youtube.com/watch?v=6ZkgySPi2WM', 'thumbnail': 'https://i.ytimg.com/vi/6ZkgySPi2WM/hqdefault.jpg', 'published': '07/06/2026' },
                        { 'title': 'Extracció Complicada - Kunduz River - Hearts and Minds - Arma 3', 'url': 'https://www.youtube.com/watch?v=WOY4A8UxBNI', 'thumbnail': 'https://i.ytimg.com/vi/WOY4A8UxBNI/hqdefault.jpg', 'published': '04/06/2026' },
                        { 'title': 'Op. Squatter - Tobruk - SAS/LRDG - Op. Stirling - WW2 - 1941 - Arma 3', 'url': 'https://www.youtube.com/watch?v=aYXWPqO7fC4', 'thumbnail': 'https://i.ytimg.com/vi/aYXWPqO7fC4/hqdefault.jpg', 'published': '31/05/2026' },
                        { 'title': 'De patrulla - Kunduz River - Hearts and Minds - Arma 3', 'url': 'https://www.youtube.com/watch?v=zRaImL2VDss', 'thumbnail': 'https://i.ytimg.com/vi/zRaImL2VDss/hqdefault.jpg', 'published': '29/05/2026' },
                        { 'title': 'Desactivant IED\'s - Kunduz River - Hearts and Minds - Arma 3', 'url': 'https://www.youtube.com/watch?v=r-qYx57dWdo', 'thumbnail': 'https://i.ytimg.com/vi/r-qYx57dWdo/hqdefault.jpg', 'published': '27/05/2026' }
                    ] %}
                    {% set displayVideos = (videos is defined and videos is not empty and videos is iterable) ? videos : fallbackVideos %}
                    
                    {% for video in displayVideos %}
                        <a href="{{ video.url|default('#') }}" target="_blank" rel="noopener noreferrer" class="cdc__video-card" style="text-decoration: none;">
                            <div class="cdc__video-thumb" style="background-image: url('{{ video.thumbnail|default('') }}'); background-size: cover; background-position: center;">
                                <span class="cdc__video-play" aria-hidden="true">▶</span>
                            </div>
                            <div class="cdc__video-body">
                                <h3 class="cdc__video-title" title="{{ video.title|default('') }}">{{ video.title|default('')|length > 60 ? video.title[:57] ~ '...' : video.title|default('') }}</h3>
                                <span class="cdc__video-date">{{ video.published|default('') }}</span>
                            </div>
                        </a>
                    {% endfor %}
                </div>
                <div class="cdc__videos-foot">
                    <a href="#" class="cdc__btn cdc__btn--outline-red">Veure més vídeos</a>
                </div>
            </div>
        </section>

        <!-- Enlist -->
        <section id="allistament" class="cdc__enlist cdc__reveal">
            <div class="cdc__enlist-bg cdc__ph" data-swap="Silueta de pilots a la pista" aria-hidden="true"></div>
            <div class="cdc__container cdc__enlist-inner">
                <div class="cdc__allistat-head">
                    <span class="cdc__eyebrow">Allistament obert</span>
                    <h2 class="cdc__h2 cdc__allistat-title">Uneix-te a l'esquadró</h2>
                    <p class="cdc__lead cdc__allistat-lead">
                        Tria com vols demanar l'accés als grups. Totes dues vies són igual de valides.
                    </p>
                </div>

                <div id="cdc-mode-choose" class="cdc__allistat-grid">
                    <article class="cdc__allistat-card" style="text-align: left;">

                        <h3 class="cdc__allistat-card-title">Discord</h3>
                        <p class="cdc__allistat-card-body">
                            Entra al nostre Discord, presenta't al canal de nous pilots i un responsable et donarà accés al grup que t'interessi.
                        </p>
                        <ul class="cdc__allistat-steps">
                            <li>Uneix-te al servidor de Discord</li>
                            <li>Vés al canal <strong>#benvinguda</strong></li>
                            <li>Explica qui ets i quins grups t'interessen</li>
                        </ul>
                        <a href="https://discord.gg/4RGJdTv" target="_blank" rel="noreferrer" class="cdc__btn cdc__btn--primary" style="align-self: flex-start; margin-top: auto;">
                            Entrar al Discord
                        </a>
                    </article>

                    <article class="cdc__allistat-card" style="text-align: left;">

                        <h3 class="cdc__allistat-card-title">Formulari</h3>
                        <p class="cdc__allistat-card-body">
                            Prefereixes fer-ho per escrit? Omple el formulari d'allistament i et contactarem per email amb els passos següents.
                        </p>
                        <ul class="cdc__allistat-steps">
                            <li>Dades bàsiques (nick, edat, email)</li>
                            <li>Grups que t'interessen</li>
                            <li>Una breu presentació</li>
                        </ul>
                        <button type="button" class="cdc__btn cdc__btn--outline-red" style="align-self: flex-start; margin-top: auto;" onclick="document.getElementById('cdc-mode-choose').style.display='none'; document.getElementById('cdc-mode-form').style.display='block';">
                            Omplir formulari
                        </button>
                    </article>
                </div>

                <form id="cdc-mode-form" class="cdc__allistat-form" novalidate style="display: none; max-width: 600px; margin: 0 auto; text-align: left; width: 100%;">
                    <button type="button" class="cdc__allistat-back" style="background: none; border: none; color: var(--cdc-muted); cursor: pointer; margin-bottom: 24px; padding: 0; font-size: 16px;" onclick="document.getElementById('cdc-mode-form').style.display='none'; document.getElementById('cdc-mode-choose').style.display='grid';">
                        ← Tornar a les opcions
                    </button>

                    <div class="cdc__field" style="margin-bottom: 16px;">
                        <label for="allistat-nick" style="display: block; margin-bottom: 8px;">Nick <span class="cdc__req-mark" style="color: var(--cdc-red);">*</span></label>
                        <input id="allistat-nick" type="text" required maxlength="40" placeholder="Escriu el teu nick" style="width: 100%; padding: 12px; background: var(--cdc-bg-2); border: 1px solid var(--cdc-line); color: var(--cdc-fg); border-radius: 4px;">
                    </div>

                    <div class="cdc__field" style="margin-bottom: 16px;">
                        <label for="allistat-edat" style="display: block; margin-bottom: 8px;">Edat</label>
                        <input id="allistat-edat" type="number" min="0" max="120" placeholder="Escriu la teva edat" style="width: 100%; padding: 12px; background: var(--cdc-bg-2); border: 1px solid var(--cdc-line); color: var(--cdc-fg); border-radius: 4px;">
                    </div>

                    <div class="cdc__field" style="margin-bottom: 16px;">
                        <label for="allistat-conegut" style="display: block; margin-bottom: 8px;">Com ens has conegut</label>
                        <input id="allistat-conegut" type="text" maxlength="200" placeholder="Escriu com ens has conegut" style="width: 100%; padding: 12px; background: var(--cdc-bg-2); border: 1px solid var(--cdc-line); color: var(--cdc-fg); border-radius: 4px;">
                    </div>

                    <div class="cdc__field" style="margin-bottom: 16px;">
                        <label for="allistat-email" style="display: block; margin-bottom: 8px;">Email <span class="cdc__req-mark" style="color: var(--cdc-red);">*</span></label>
                        <input id="allistat-email" type="email" required maxlength="255" placeholder="Escriu el teu correu electrònic" style="width: 100%; padding: 12px; background: var(--cdc-bg-2); border: 1px solid var(--cdc-line); color: var(--cdc-fg); border-radius: 4px;">
                    </div>

                    <fieldset class="cdc__field cdc__field--check" style="margin-bottom: 16px; border: none; padding: 0;">
                        <legend style="margin-bottom: 8px;">Grups que t'interessen <span class="cdc__req-mark" style="color: var(--cdc-red);">*</span></legend>
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <label class="cdc__check" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                <input type="checkbox" name="allistat-grups" value="Arma">
                                <span>Arma</span>
                            </label>
                            <label class="cdc__check" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                <input type="checkbox" name="allistat-grups" value="DCS World">
                                <span>DCS World</span>
                            </label>
                            <label class="cdc__check" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                <input type="checkbox" name="allistat-grups" value="IL-2 Sturmovik">
                                <span>IL-2 Sturmovik</span>
                            </label>
                            <label class="cdc__check" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                <input type="checkbox" name="allistat-grups" value="Star Citizen">
                                <span>Star Citizen</span>
                            </label>
                        </div>
                    </fieldset>

                    <div class="cdc__field" style="margin-bottom: 24px;">
                        <label for="allistat-presentacio" style="display: block; margin-bottom: 8px;">
                            Presentació <span class="cdc__req-mark" style="color: var(--cdc-red);">*</span>
                        </label>
                        <textarea id="allistat-presentacio" required rows="6" maxlength="2000" placeholder="Escriu la teva presentació" style="width: 100%; padding: 12px; background: var(--cdc-bg-2); border: 1px solid var(--cdc-line); color: var(--cdc-fg); resize: vertical; border-radius: 4px;"></textarea>
                    </div>

                    <div class="cdc__allistat-actions" style="display: flex; gap: 16px;">
                        <button type="submit" class="cdc__btn cdc__btn--primary">Enviar</button>
                        <button type="reset" class="cdc__btn cdc__btn--ghost">Netejar</button>
                    </div>
                </form>

                <div id="cdc-mode-sent" class="cdc__allistat-done" role="status" aria-live="polite" style="display: none; max-width: 600px; margin: 0 auto; text-align: center;">
                    <h3 class="cdc__h2 cdc__allistat-title" style="margin-bottom: 16px;">Gràcies per l'interès!</h3>
                    <p class="cdc__lead" style="margin-bottom: 24px;">
                        S'ha obert el teu client de correu amb l'allistament. Envia el missatge i et respondrem al més aviat possible.
                    </p>
                    <button type="button" class="cdc__btn cdc__btn--outline-red" onclick="document.getElementById('cdc-mode-sent').style.display='none'; document.getElementById('cdc-mode-choose').style.display='grid';">
                        Tornar a les opcions
                    </button>
                </div>
            </div>
        </section>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var form = document.getElementById('cdc-mode-form');
                if(form) {
                    form.addEventListener('submit', function(e) {
                        e.preventDefault();
                        var nick = document.getElementById('allistat-nick').value;
                        var email = document.getElementById('allistat-email').value;
                        var edat = document.getElementById('allistat-edat').value;
                        var conegut = document.getElementById('allistat-conegut').value;
                        var presentacio = document.getElementById('allistat-presentacio').value;
                        
                        var grupsEls = document.querySelectorAll('input[name="allistat-grups"]:checked');
                        if (!nick || !email || !presentacio || grupsEls.length === 0) {
                            alert('Si us plau, omple tots els camps obligatoris i selecciona almenys un grup.');
                            return;
                        }
                        
                        var grups = Array.from(grupsEls).map(function(el) { return el.value; }).join(', ');
                        
                        var emailBody = "Nick: " + nick + "\nEdat: " + edat + "\nCom ens has conegut: " + conegut + "\nEmail: " + email + "\nGrups: " + grups + "\n\nPresentació:\n" + presentacio;
                        
                        window.location.href = "mailto:contacte@cavallersdelcel.cat?subject=" + encodeURIComponent("Allistament — " + nick) + "&body=" + encodeURIComponent(emailBody);
                        
                        document.getElementById('cdc-mode-form').style.display = 'none';
                        document.getElementById('cdc-mode-sent').style.display = 'block';
                        this.reset();
                    });
                }
            });
        </script>
    </main>

    <!-- Footer -->
    <footer class="cdc__footer">
        <div class="cdc__container">
            <div class="cdc__footer-top">
                <div class="cdc__footer-brand">
                    <div class="cdc__brand">
                        <img src="{{ logo }}" alt="logo" style="width: 32px; height: 32px; margin-right: 12px; object-fit: contain;">
                        Cavallers del Cel
                    </div>
                    <p>La comunitat catalana de simulació de combat. Volant junts des de fa anys, amb disciplina i companyonia.</p>
                </div>
                <div class="cdc__footer-col">
                    <h4>Divisions</h4>
                    <ul>
                        <li><a href="#">DCS World</a></li>
                        <li><a href="#">BMS</a></li>
                        <li><a href="#">Arma 3</a></li>
                        <li><a href="#">IL-2 Sturmovik</a></li>
                    </ul>
                </div>
                <div class="cdc__footer-col">
                    <h4>Més informació</h4>
                    <ul>
                        <li><a href="#">Normativa</a></li>
                        <li><a href="#">Contacte</a></li>
                        <li><a href="#">Equipament</a></li>
                    </ul>
                </div>
            </div>
            <div class="cdc__footer-bottom">
                <span>© 2026 Cavallers del Cel. Tots els drets reservats.</span>
                <a href="https://www.cavallersdelcel.cat">cavallersdelcel.cat</a>
            </div>
        </div>
    </footer>
</div>

<style>
/* CSS fix for the images */
.cdc__hero-bg img, .cdc__about-image img, .cdc__op-image img, .cdc__enlist-bg img { 
    width: 100%; height: 100%; object-fit: cover; 
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
    // Sticky Nav
    const nav = document.getElementById("cdc-navbar");
    if (nav) {
        const onScroll = () => {
            if (window.scrollY > 40) {
                nav.classList.add("cdc__nav--scrolled");
            } else {
                nav.classList.remove("cdc__nav--scrolled");
            }
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
    }

    // Scroll Reveal Intersection Observer
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add("cdc__reveal--in");
                observer.unobserve(entry.target);
            }
        });
    }, {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px"
    });

    document.querySelectorAll(".cdc__reveal").forEach((el) => {
        observer.observe(el);
    });

    // Disable videos if reduced motion is requested
    const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    const handleMotion = (e) => {
        const iframe = document.querySelector(".cdc__hero-video");
        if (iframe) {
            iframe.style.display = e.matches ? "none" : "block";
        }
    };
    if (motionQuery) {
        handleMotion(motionQuery);
        motionQuery.addEventListener("change", handleMotion);
    }
});
</script>
{% endblock %}
