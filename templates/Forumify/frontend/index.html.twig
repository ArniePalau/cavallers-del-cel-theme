{% extends '@Forumify/frontend/base.html.twig' %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}
{% block breadcrumbs %}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap">
    <style>
/* Cavallers del Cel — full-width landing styles */
html, body, main, main.responsive, .body-wrapper {
  overflow-x: hidden;
  max-width: 100% !important;
  width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
}


.cdc {
  --cdc-bg: #05080f;
  --cdc-bg-2: #0b111c;
  --cdc-fg: #f2f2f2;
  --cdc-muted: #a8b0bf;
  --cdc-muted-2: #8a93a3;
  --cdc-line: #182238;
  --cdc-red: #1e3a8a;
  --cdc-red-hover: #2b4bb0;
  --cdc-accent: #f7c948;
  --cdc-font-display: "Oswald", "Barlow Condensed", Impact, sans-serif;
  --cdc-font-body: "Inter", system-ui, -apple-system, Segoe UI, Roboto, sans-serif;

  background: var(--cdc-bg);
  color: var(--cdc-fg);
  font-family: var(--cdc-font-body);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}

.cdc *,
.cdc *::before,
.cdc *::after {
  box-sizing: border-box;
}

.cdc a { color: inherit; text-decoration: none; }

/* Override global navbar hover/active colors */
:root, [data-theme="dark"], [data-theme="light"], body {
  --primary: #2b4bb0 !important;
  --ph-primary: #2b4bb0 !important;
  --ph-primary-color: #2b4bb0 !important;
  --c-call-to-action: #2b4bb0 !important;
  --c-call-to-action-accent: #1e3a8a !important;
}

.ph-navbar a:hover, .ph-navbar a:hover *,
.ph-navbar a.active, .ph-navbar a.active *,
.ph-navbar a[aria-expanded="true"], .ph-navbar a[aria-expanded="true"] *,
.ph-navbar li:hover > a, .ph-navbar li:hover > a *,
.ph-nav a:hover, .ph-nav a:hover *,
.ph-nav a.active, .ph-nav a.active *,
.ph-nav a[aria-expanded="true"], .ph-nav a[aria-expanded="true"] *,
.ph-nav li:hover > a, .ph-nav li:hover > a *,
.nav-link:hover, .nav-link:hover *,
.nav-link.active, .nav-link.active *,
.nav-link[aria-expanded="true"], .nav-link[aria-expanded="true"] *,
.nav-item:hover > a, .nav-item:hover > a *,
.nav-item > a:hover, .nav-item > a:hover *,
.nav-item > a.active, .nav-item > a.active *,
.nav-item > a[aria-expanded="true"], .nav-item > a[aria-expanded="true"] *,
.menu-item:hover > a, .menu-item:hover > a *,
header a:hover, header a:hover *,
header a.active, header a.active *,
header a[aria-expanded="true"], header a[aria-expanded="true"] *,
header li:hover > a, header li:hover > a *,
.header a:hover, .header a:hover *,
.header a.active, .header a.active *,
.header a[aria-expanded="true"], .header a[aria-expanded="true"] *,
.header li:hover > a, .header li:hover > a *,
nav a:hover, nav a:hover *,
nav a.active, nav a.active *,
nav a[aria-expanded="true"], nav a[aria-expanded="true"] *,
nav li:hover > a, nav li:hover > a *,
[class*="nav"] a:hover, [class*="nav"] a:hover *,
[class*="nav"] a.active, [class*="nav"] a.active *,
[class*="nav"] a[aria-expanded="true"], [class*="nav"] a[aria-expanded="true"] *,
[class*="nav"] li:hover > a, [class*="nav"] li:hover > a *,
.btn-link:hover, .btn-link:hover *,
.btn-link.active, .btn-link.active *,
.btn-link[aria-expanded="true"], .btn-link[aria-expanded="true"] * {
    color: #2b4bb0 !important;
}

nav a.active, .header a.active, nav a[aria-expanded="true"], .header a[aria-expanded="true"],
nav li:hover > a.active, .header li:hover > a.active {
    background-color: rgba(43, 75, 176, 0.15) !important;
}
.cdc img { max-width: 100%; display: block; }

.cdc__container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 24px;
}

.cdc__eyebrow {
  font-family: var(--cdc-font-body);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--cdc-muted);
  display: inline-flex;
  align-items: center;
  gap: 12px;
}
.cdc__eyebrow::before {
  content: "";
  width: 32px;
  height: 2px;
  background: var(--cdc-red);
  display: inline-block;
}

.cdc__h1,
.cdc__h2 {
  font-family: var(--cdc-font-display);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.01em;
  line-height: 0.95;
  margin: 0;
  color: var(--cdc-fg);
}
.cdc__h1 { font-size: clamp(48px, 9vw, 128px); }
.cdc__h2 { font-size: clamp(36px, 5vw, 64px); }

.cdc__lead {
  font-size: clamp(16px, 1.4vw, 20px);
  color: var(--cdc-muted);
  max-width: 60ch;
}

/* Buttons */
.cdc__btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 16px 28px;
  font-family: var(--cdc-font-body);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  border: 1px solid transparent;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}
.cdc__btn--primary {
  background: var(--cdc-red);
  color: #fff;
}
.cdc__btn--primary:hover { background: var(--cdc-red-hover); }
.cdc__btn--ghost {
  background: transparent;
  color: var(--cdc-fg);
  border-color: var(--cdc-fg);
}
.cdc__btn--ghost:hover { background: var(--cdc-fg); color: var(--cdc-bg); }
.cdc__btn--outline-red {
  background: transparent;
  color: var(--cdc-fg);
  border-color: var(--cdc-red);
}
.cdc__btn--outline-red:hover { background: var(--cdc-red); }

/* Placeholders */
.cdc__ph {
  position: relative;
  background:
    linear-gradient(135deg, #17181b 0%, #0d0e10 100%);
  border: 1px solid var(--cdc-line);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cdc-muted);
}
.cdc__ph::after {
  content: attr(data-swap);
  position: absolute;
  bottom: 12px;
  left: 12px;
  right: 12px;
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--cdc-muted);
  opacity: 0.7;
}
.cdc__ph::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    repeating-linear-gradient(45deg, transparent 0 22px, rgba(255,255,255,0.02) 22px 23px);
}

/* Nav */
.cdc__nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 50;
  transition: background 0.2s ease, border-color 0.2s ease;
  border-bottom: 1px solid transparent;
}
.cdc__nav--scrolled {
  background: rgba(10,10,10,0.92);
  backdrop-filter: blur(8px);
  border-bottom-color: var(--cdc-line);
}
.cdc__nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72px;
}
.cdc__brand {
  font-family: var(--cdc-font-display);
  font-weight: 700;
  font-size: 18px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  display: inline-flex;
  align-items: center;
  gap: 12px;
}
.cdc__brand-logo {
  width: 32px;
  height: 32px;
  object-fit: contain;
  display: block;
}
.cdc__nav-links {
  display: none;
  gap: 32px;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
@media (min-width: 900px) { .cdc__nav-links { display: inline-flex; } }
.cdc__nav-links a { color: var(--cdc-fg); opacity: 0.85; }
.cdc__nav-links a:hover { color: var(--cdc-red); opacity: 1; }
.cdc__nav-cta {
  padding: 10px 20px;
  font-size: 12px;
}

/* Hero */
.cdc__hero {
  position: relative;
  min-height: calc(100vh - 60px);
  height: calc(100vh - 60px);
  display: flex;
  align-items: flex-end;
  padding: 80px 0 80px;
  overflow: hidden;
}
.cdc__hero-bg {
  position: absolute; inset: 0;
  z-index: 0;
}
.cdc__hero-bg { background: #05080f; }
.cdc__hero-video {
  position: absolute;
  top: 50%;
  left: 50%;
  /* Scale to cover: use max(100vw, 177.78vh) for width to preserve 16:9 */
  width: 100vw;
  height: 56.25vw; /* 16:9 based on width */
  min-height: 100vh;
  min-width: 177.78vh; /* 16:9 based on height */
  transform: translate(-50%, -50%) scale(1.35); /* extra scale hides YT chrome */
  border: 0;
  pointer-events: none;
}
.cdc__hero-bg::after {
  content: "";
  position: absolute; inset: 0;
  background:
    linear-gradient(180deg, rgba(10,10,10,0.35) 0%, rgba(10,10,10,0.55) 55%, rgba(10,10,10,0.95) 100%),
    radial-gradient(ellipse at 70% 30%, rgba(30,58,138,0.22), transparent 60%);
  pointer-events: none;
}

.cdc__hero-inner {
  position: relative;
  z-index: 1;
  width: 100%;
}
.cdc__hero-eyebrow { margin-bottom: 24px; }
.cdc__hero-title { max-width: 14ch; }
.cdc__hero-sub {
  margin-top: 24px;
  max-width: 52ch;
  font-size: clamp(16px, 1.4vw, 20px);
  color: #cbd0d6;
}
.cdc__hero-ctas {
  margin-top: 40px;
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  align-items: center;
}
.cdc__hero-meta {
  position: absolute;
  right: 24px;
  top: 50%;
  transform: translateY(-50%) rotate(90deg);
  transform-origin: right center;
  font-size: 11px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--cdc-muted);
  display: none;
}
@media (min-width: 1100px) { .cdc__hero-meta { display: block; } }

/* Sections */
.cdc__section {
  padding: 120px 0;
  border-top: 1px solid var(--cdc-line);
}
.cdc__section-head {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 64px;
  max-width: 720px;
}

/* About */
.cdc__about-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 48px;
}
@media (min-width: 900px) {
  .cdc__about-grid { grid-template-columns: 1.1fr 0.9fr; gap: 64px; }
}
.cdc__about-copy p {
  font-size: 18px;
  color: #cbd0d6;
  max-width: 55ch;
}
.cdc__about-image { aspect-ratio: 4/5; }

.cdc__stats {
  margin-top: 80px;
  display: grid;
  grid-template-columns: 1fr;
  border-top: 1px solid var(--cdc-line);
}
@media (min-width: 640px) {
  .cdc__stats { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 1024px) {
  .cdc__stats { grid-template-columns: repeat(4, 1fr); }
}
.cdc__stat {
  padding: 32px 24px;
  border-bottom: 1px solid var(--cdc-line);
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 8px;
}
.cdc__stat:last-child { border-bottom: 0; }
@media (min-width: 640px) {
  .cdc__stat { border-bottom: 0; border-right: 1px solid var(--cdc-line); }
  .cdc__stat:last-child { border-right: 0; }
}

.cdc__stat-icon {
  width: 24px;
  height: 24px;
  color: var(--cdc-fg);
  margin-bottom: 8px;
}
.cdc__stat-val {
  font-family: var(--cdc-font-display);
  font-size: clamp(36px, 5vw, 56px);
  color: var(--cdc-fg);
  line-height: 1;
}
.cdc__stat-label {
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--cdc-muted);
  margin-top: 12px;
}

/* Operations */
.cdc__ops-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}
@media (min-width: 800px) {
  .cdc__ops-grid { grid-template-columns: repeat(3, 1fr); }
}
.cdc__op-card {
  display: flex;
  flex-direction: column;
  background: var(--cdc-bg-2);
  border: 1px solid var(--cdc-line);
  transition: border-color 0.2s ease, transform 0.2s ease;
}
.cdc__op-card:hover { border-color: var(--cdc-red); }
.cdc__op-image { aspect-ratio: 4/3; }
.cdc__op-body {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  flex: 1;
}
.cdc__op-code {
  font-size: 11px;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--cdc-red);
  font-weight: 600;
}
.cdc__op-title {
  font-family: var(--cdc-font-display);
  font-size: 26px;
  text-transform: uppercase;
  margin: 0;
  color: var(--cdc-fg);
}
.cdc__op-brief { color: var(--cdc-muted); font-size: 15px; }
.cdc__op-cta {
  margin-top: auto;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--cdc-fg);
  padding-top: 12px;
  border-top: 1px solid var(--cdc-line);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.cdc__op-cta::after {
  content: "→";
  color: var(--cdc-red);
  transition: transform 0.15s ease;
}
.cdc__op-card:hover .cdc__op-cta::after { transform: translateX(4px); }

/* Enlist */
.cdc__enlist {
  position: relative;
  padding: 0;
  border-top: 1px solid var(--cdc-line);
}
.cdc__enlist-bg { position: absolute; inset: 0; z-index: 0; }
.cdc__enlist-bg::after {
  content: "";
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(10,10,10,0.85), rgba(10,10,10,0.95));
}
.cdc__enlist-inner {
  position: relative;
  z-index: 1;
  padding: 140px 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
}
.cdc__enlist-title { max-width: 16ch; }
.cdc__enlist-body { color: #cbd0d6; max-width: 52ch; margin: 0 auto; }
.cdc__enlist-cta { margin-top: 16px; }
.cdc__enlist-reqs {
  margin-top: 48px;
  padding-top: 32px;
  border-top: 1px solid var(--cdc-line);
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
  width: 100%;
  max-width: 900px;
}
@media (min-width: 700px) {
  .cdc__enlist-reqs { grid-template-columns: repeat(3, 1fr); }
}
.cdc__req {
  font-size: 13px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--cdc-muted);
  display: flex;
  align-items: center;
  gap: 12px;
  justify-content: center;
}
.cdc__req::before {
  content: "";
  width: 8px; height: 8px;
  background: var(--cdc-red);
  display: inline-block;
}

/* Footer */
.cdc__footer {
  border-top: 2px solid var(--cdc-red);
  padding: 64px 0 32px;
  background: #060606;
}
.cdc__footer-top {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
  padding-bottom: 48px;
  border-bottom: 1px solid var(--cdc-line);
}
@media (min-width: 800px) {
  .cdc__footer-top { grid-template-columns: 1.4fr repeat(4, 1fr); }
}
.cdc__footer-brand p {
  color: var(--cdc-muted);
  font-size: 14px;
  max-width: 32ch;
  margin: 12px 0 0;
}
.cdc__footer-col h4 {
  font-family: var(--cdc-font-body);
  font-size: 12px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--cdc-fg);
  margin: 0 0 16px;
}
.cdc__footer-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
.cdc__footer-col a {
  color: var(--cdc-muted);
  font-size: 14px;
  transition: color 0.15s ease;
}
.cdc__footer-col a:hover { color: var(--cdc-fg); }
.cdc__footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24px;
  color: var(--cdc-muted);
  font-size: 12px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  gap: 16px;
  flex-wrap: wrap;
}

/* Reveal on scroll */
.cdc__reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
.cdc__reveal--in { opacity: 1; transform: none; }

/* Community grid */
.cdc__community-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}
@media (min-width: 900px) {
  .cdc__community-grid { grid-template-columns: 1.2fr 1fr 1fr; }
}
.cdc__panel {
  background: var(--cdc-bg-2);
  border: 1px solid var(--cdc-line);
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

.cdc__panel-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--cdc-line);
}
.cdc__panel-title {
  font-family: var(--cdc-font-display);
  font-size: 20px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin: 0;
}
.cdc__panel-meta {
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--cdc-muted);
}
.cdc__panel-cta { align-self: flex-start; margin-top: auto; }

/* Calendar */
.cdc__cal-weekdays,
.cdc__cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4px;
}
.cdc__cal-weekdays {
  font-size: 10px;
  letter-spacing: 0.2em;
  color: var(--cdc-muted);
  text-align: center;
  text-transform: uppercase;
  padding-bottom: 4px;
}
.cdc__cal-cell {
  position: relative;
  aspect-ratio: 1/1;
  background: #0a1120;
  border: 1px solid #131c2e;
  padding: 4px;
  font-size: 11px;
  color: var(--cdc-muted);
  min-width: 0;
  overflow: hidden;
}
@media (min-width: 500px) {
  .cdc__cal-cell { min-height: 44px; }
}

.cdc__cal-cell--today {
  border-color: var(--cdc-accent);
  box-shadow: inset 0 0 0 1px var(--cdc-accent);
}
.cdc__cal-cell--today .cdc__cal-day { color: var(--cdc-accent); }
.cdc__cal-day { font-weight: 600; position: relative; z-index: 1; }
.cdc__cal-tag {
  position: absolute;
  left: 2px;
  right: 2px;
  bottom: 2px;
  font-size: 8px;
  padding: 1px 2px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #fff;
  text-align: center;
  font-weight: 700;
  line-height: 1.2;
}

.cdc__cal-tag--dcs { background: #1e3a8a; }
.cdc__cal-tag--bms { background: #b91c1c; }
.cdc__cal-tag--brief { background: #7c3aed; }
.cdc__cal-tag--arma3 { background: #4d7c0f; }
.cdc__cal-tag--il2 { background: #a16207; }
.cdc__cal-tag--starcitizen { background: #0f172a; border: 1px solid #334155; }
.cdc__cal-tag--op { background: #991b1b; }

/* Live embeds (Discord + Facebook) */
.cdc__embed {
  position: relative;
  background: #000;
  border: 1px solid var(--cdc-line);
  overflow: hidden;
  flex: 1;
  min-height: 420px;
}
.cdc__embed iframe {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 420px;
  border: 0;
}
.cdc__embed--facebook { background: #18191a; }


/* Videos */
.cdc__videos-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}
@media (min-width: 640px) { .cdc__videos-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .cdc__videos-grid { grid-template-columns: repeat(4, 1fr); } }
.cdc__video-card {
  background: var(--cdc-bg-2);
  border: 1px solid var(--cdc-line);
  display: flex;
  flex-direction: column;
  transition: border-color 0.2s ease;
}
.cdc__video-card:hover { border-color: var(--cdc-red); }
.cdc__video-thumb {
  aspect-ratio: 16/9;
  position: relative;
}
.cdc__video-play {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(30,58,138,0.9);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  z-index: 2;
}
.cdc__video-body {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.cdc__video-title {
  font-size: 14px;
  margin: 0;
  color: var(--cdc-fg);
  line-height: 1.4;
}
.cdc__video-date {
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--cdc-muted);
}
.cdc__videos-foot { margin-top: 40px; text-align: center; }

/* Groups (Els nostres grups) */
.cdc__section-head--center {
  align-items: center;
  text-align: center;
  margin-left: auto;
  margin-right: auto;
}
.cdc__groups-lead { margin-top: 4px; }
.cdc__groups-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}
@media (min-width: 700px) {
  .cdc__groups-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 1100px) {
  .cdc__groups-grid { grid-template-columns: repeat(4, 1fr); }
}
.cdc__group-card {
  position: relative;
  overflow: hidden;
  background: var(--cdc-bg-2);
  border: 1px solid var(--cdc-line);
  padding: 40px 28px 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: border-color 0.2s ease, transform 0.2s ease;
}
.cdc__group-video-wrap {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.4s ease;
  z-index: 1;
}
.cdc__group-card:hover .cdc__group-video-wrap {
  opacity: 1;
}
.cdc__group-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.cdc__group-video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(10, 15, 26, 0.7) 0%, rgba(10, 15, 26, 0.85) 100%);
}
.cdc__group-emblem,
.cdc__group-title,
.cdc__group-body,
.cdc__group-cta {
  position: relative;
  z-index: 2;
}
.cdc__group-card:hover { border-color: var(--cdc-red); transform: translateY(-2px); }
.cdc__group-emblem {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  margin-bottom: 24px;
}
.cdc__group-emblem::after { display: none; }
.cdc__group-emblem--img {
  width: 120px;
  height: 120px;
  border-radius: 0;
  object-fit: contain;
  background: transparent;
}

.cdc__group-title {
  font-family: var(--cdc-font-display);
  font-size: 22px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin: 0 0 12px;
  color: var(--cdc-fg);
}
.cdc__group-body {
  color: var(--cdc-muted);
  font-size: 14px;
  line-height: 1.6;
  margin: 0 0 24px;
  flex: 1;
}
.cdc__group-cta {
  padding: 12px 20px;
  font-size: 11px;
  width: 100%;
  justify-content: center;
}


/* Allistament page */
.cdc__allistat {
  padding: 140px 0 80px;
  min-height: 100vh;
  background: var(--cdc-bg);
}
.cdc__allistat-inner { display: block; }
.cdc__allistat-head { max-width: 720px; margin: 0 auto 56px; text-align: center; }
.cdc__allistat-head .cdc__eyebrow { justify-content: center; }
.cdc__allistat-title { margin: 16px 0 20px; }
.cdc__allistat-lead { margin: 0 auto; color: var(--cdc-muted); }

.cdc__allistat-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
  max-width: 960px;
  margin: 0 auto;
}
@media (min-width: 800px) {
  .cdc__allistat-grid { grid-template-columns: 1fr 1fr; }
}
.cdc__allistat-card {
  background: var(--cdc-bg-2);
  border: 1px solid var(--cdc-line);
  padding: 32px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.cdc__allistat-badge {
  font-family: var(--cdc-font-body);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--cdc-red);
  align-self: flex-start;
  padding: 6px 10px;
  border: 1px solid var(--cdc-red);
}
.cdc__allistat-card-title {
  font-family: var(--cdc-font-display);
  font-size: 32px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin: 0;
  color: var(--cdc-fg);
}
.cdc__allistat-card-body { color: var(--cdc-muted); margin: 0; font-size: 15px; }
.cdc__allistat-steps {
  list-style: none;
  padding: 0;
  margin: 8px 0 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: var(--cdc-muted);
  font-size: 14px;
}
.cdc__allistat-steps li {
  padding-left: 20px;
  position: relative;
}
.cdc__allistat-steps li::before {
  content: "›";
  position: absolute;
  left: 0;
  color: var(--cdc-red);
  font-weight: 700;
}
.cdc__allistat-card .cdc__btn { align-self: flex-start; margin-top: auto; }

/* Form */
.cdc__allistat-form {
  max-width: 640px;
  margin: 0 auto;
  background: var(--cdc-bg-2);
  border: 1px solid var(--cdc-line);
  padding: 32px;
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.cdc__allistat-back {
  background: none;
  border: none;
  color: var(--cdc-muted);
  cursor: pointer;
  font-size: 12px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  padding: 0;
  align-self: flex-start;
}
.cdc__allistat-back:hover { color: var(--cdc-fg); }

.cdc__field { display: flex; flex-direction: column; gap: 8px; }
.cdc__field label,
.cdc__field legend {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--cdc-fg);
  padding: 0;
}
.cdc__req-mark { color: var(--cdc-red); }
.cdc__field input,
.cdc__field textarea {
  background: var(--cdc-bg);
  border: 1px solid var(--cdc-line);
  color: var(--cdc-fg);
  font-family: var(--cdc-font-body);
  font-size: 15px;
  padding: 12px 14px;
  width: 100%;
  border-radius: 0;
  outline: none;
  transition: border-color 0.15s ease;
}
.cdc__field input:focus,
.cdc__field textarea:focus { border-color: var(--cdc-red); }
.cdc__field textarea { resize: vertical; min-height: 120px; font-family: var(--cdc-font-body); }

.cdc__field--check { border: none; margin: 0; }
.cdc__check {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  color: var(--cdc-fg);
  padding: 6px 0;
  text-transform: none;
  letter-spacing: 0;
  font-weight: 400;
  cursor: pointer;
}
.cdc__check input { width: 16px; height: 16px; accent-color: var(--cdc-red); }

.cdc__allistat-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }

.cdc__allistat-done {
  max-width: 640px;
  margin: 0 auto;
  text-align: center;
  padding: 48px 24px;
  border: 1px solid var(--cdc-line);
  background: var(--cdc-bg-2);
  display: flex;
  flex-direction: column;
  gap: 20px;
  align-items: center;
}

/* ============================================================
   A11Y + PERFORMANCE + POLISH (added)
   ============================================================ */

/* Skip link */
.cdc__skip-link {
  position: fixed;
  top: 8px;
  left: 8px;
  z-index: 100;
  padding: 10px 16px;
  background: var(--cdc-accent);
  color: #0a0a0a;
  font-family: var(--cdc-font-body);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  transform: translateY(-150%);
  transition: transform 0.15s ease;
}
.cdc__skip-link:focus { transform: translateY(0); outline: none; }

/* Focus visible — unified across the landing */
.cdc :focus { outline: none; }
.cdc a:focus-visible,
.cdc button:focus-visible,
.cdc input:focus-visible,
.cdc textarea:focus-visible,
.cdc [tabindex]:focus-visible {
  outline: 2px solid var(--cdc-accent);
  outline-offset: 3px;
}
.cdc__cal-cell:focus-visible { outline-offset: -1px; }

/* Hero poster (shown while iframe loads / when reduced motion) */
.cdc__hero-poster {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
  filter: brightness(0.75) saturate(1.05);
}
.cdc__hero-video { z-index: 1; }

/* Nav HUD underline */
.cdc__nav-link {
  position: relative;
  padding: 4px 0;
}
.cdc__nav-link::after {
  content: "";
  position: absolute;
  left: 0;
  right: 100%;
  bottom: -6px;
  height: 2px;
  background: var(--cdc-accent);
  transition: right 0.25s cubic-bezier(.2,.7,.2,1);
}
.cdc__nav-link:hover::after,
.cdc__nav-link:focus-visible::after { right: 0; }

/* Buttons: subtle shine on hover for primary */
.cdc__btn { position: relative; overflow: hidden; }
.cdc__btn--primary::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.18) 50%, transparent 70%);
  transform: translateX(-120%);
  transition: transform 0.6s cubic-bezier(.2,.7,.2,1);
  pointer-events: none;
}
.cdc__btn--primary:hover::before { transform: translateX(120%); }
.cdc__btn:active { transform: translateY(1px); }

/* Card hover polish (ops + groups) */
.cdc__op-card,
.cdc__group-card {
  transition: border-color 0.25s cubic-bezier(.2,.7,.2,1),
              transform 0.25s cubic-bezier(.2,.7,.2,1),
              box-shadow 0.25s cubic-bezier(.2,.7,.2,1);
}
.cdc__op-card:hover,
.cdc__group-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 40px -20px rgba(30,58,138,0.5);
}
.cdc__op-title,
.cdc__group-title { position: relative; display: inline-block; }
.cdc__op-title::after,
.cdc__group-title::after {
  content: "";
  position: absolute;
  left: 0; right: 100%;
  bottom: -6px;
  height: 2px;
  background: var(--cdc-red);
  transition: right 0.3s cubic-bezier(.2,.7,.2,1);
}
.cdc__op-card:hover .cdc__op-title::after,
.cdc__group-card:hover .cdc__group-title::after { right: 30%; }

/* Calendar cell hover */
.cdc__cal-cell {
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  cursor: default;
}
.cdc__cal-cell:hover {
  border-color: rgba(247,201,72,0.5);
  box-shadow: inset 0 0 12px rgba(247,201,72,0.08);
}

/* HUD section separator — subtle ticks over the top border */
.cdc__section {
  position: relative;
}
.cdc__section::before {
  content: "";
  position: absolute;
  top: 0;
  left: 24px;
  right: 24px;
  height: 6px;
  background-image: repeating-linear-gradient(
    90deg,
    var(--cdc-line) 0 1px,
    transparent 1px 24px
  );
  opacity: 0.7;
  pointer-events: none;
}

/* Reduced motion — turn everything static */
@media (prefers-reduced-motion: reduce) {
  .cdc *,
  .cdc *::before,
  .cdc *::after {
    animation: none !important;
    transition: none !important;
  }
  .cdc__reveal { opacity: 1 !important; transform: none !important; }
  .cdc__op-card:hover,
  .cdc__group-card:hover { transform: none !important; box-shadow: none !important; }
  .cdc__hero-video { display: none; }
}

</style>
{% endblock %}

{% block body %}
<div class="cdc">
    <!-- Navbar -->
    

    <main id="contingut">
