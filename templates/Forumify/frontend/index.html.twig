                <iframe class="cdc__hero-video" src="https://www.youtube-nocookie.com/embed/yYpJjA_rmWw?autoplay=1&mute=1&loop=1&playlist=yYpJjA_rmWw&controls=0&showinfo=0&modestbranding=1&rel=0&iv_load_policy=3&playsinline=1&disablekb=1" title="Cavallers del Cel — vídeo de fons" allow="autoplay; encrypted-media; picture-in-picture" loading="lazy" frameborder="0" tabindex="-1"></iframe>
            </div>
            <div class="cdc__container cdc__hero-inner">
