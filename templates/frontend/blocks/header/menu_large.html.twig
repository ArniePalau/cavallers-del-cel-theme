{% extends '@!Forumify/frontend/blocks/header/menu_large.html.twig' %}
{% block menu_large %}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&display=swap');

        .cdc-old-menu ul { list-style: none; display: flex; margin: 0; padding: 0; gap: 2.25rem; align-items: center; }
        .cdc-old-menu li { margin: 0; padding: 0; }
        .cdc-old-menu a,
        .header nav a,
        .cdc__nav-links a,
        nav a.btn-link,
        .cdc__nav a { 
            color: rgba(255, 255, 255, 0.9) !important; 
            text-transform: uppercase !important; 
            font-family: 'Oswald', 'Barlow Condensed', Impact, sans-serif !important; 
            font-size: 14px !important; 
            font-weight: 600 !important; 
            letter-spacing: 0.1em !important; 
            text-decoration: none !important; 
            transition: opacity 0.2s ease, color 0.2s ease, transform 0.2s ease !important; 
        }
        .cdc-old-menu a:hover, 
        .cdc-old-menu a.active,
        .header nav a:hover,
        .header nav a.active,
        .cdc__nav a:hover,
        .cdc__nav a.active { 
            opacity: 1 !important; 
            color: #3b82f6 !important; 
        }
        .cdc-user-dropdown { 
            display: flex; 
            align-items: center; 
            cursor: pointer; 
            color: rgba(255, 255, 255, 0.9) !important; 
            font-family: 'Oswald', 'Barlow Condensed', Impact, sans-serif !important; 
            font-weight: 600 !important; 
            letter-spacing: 0.08em !important; 
            text-transform: uppercase !important; 
            font-size: 14px !important; 
            margin-left: 1.25rem; 
        }
        .cdc-user-dropdown:hover { opacity: 1 !important; }
    </style>
    <div class="flex-grow flex flex-row items-center justify-between hide-phone">
        <nav class="cdc-old-menu flex flex-wrap flex-grow justify-end text-large pr-3 mr-3 border-r" style="border: none; margin-right: 1.5rem;">
            {{ forum_menu() }}
        </nav>
        {% if app.user is not null %}
            <div class="flex flex-row">
                <div {{ stimulus_controller('forumify/forumify-platform/menu', { placement: 'bottom-end' }) }}>
                    <a class="btn-link header-menu pl-2 cdc-user-dropdown" {{ stimulus_target('forumify/forumify-platform/menu', 'openButton') }}>
                        {% include '@Forumify/components/avatar.html.twig' with {
                            user: app.user,
                            className: 'avatar-sm',
                        } only %}
                        <span class="ml-2">{{ app.user.displayName }}</span>
                    </a>
                    <div class="menu" {{ stimulus_target('forumify/forumify-platform/menu', 'menu') }}>
                        {% include '@Forumify/frontend/blocks/header/fixed_menu.html.twig' %}
                    </div>
                </div>
            </div>
        {% else %}
            <a class="cdc__btn cdc__btn--outline-red cdc__nav-cta" href="{{ path('forumify_core_login', { '_target_path': app.request.requestUri }) }}">
                {{ 'login'|trans }}
            </a>
        {% endif %}
    </div>
{% endblock %}
